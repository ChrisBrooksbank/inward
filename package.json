{
    "name": "inward",
    "version": "0.0.1",
    "description": "A peer-to-peer PWA for interoception training - helping people recognize and describe internal body sensations",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "lint": "eslint . && svelte-check --tsconfig ./tsconfig.json",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "knip": "knip",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test:run",
        "generate:icons": "node scripts/generate-icons.mjs",
        "prepare": "husky"
    },
    "dependencies": {
        "idb": "^8.0.0",
        "zod": "^3.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.40.0",
        "@sveltejs/adapter-static": "^3.0.0",
        "@sveltejs/kit": "^2.0.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@types/node": "^22.0.0",
        "@vite-pwa/sveltekit": "^0.6.0",
        "@vitest/coverage-v8": "^2.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-svelte": "^2.0.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^16.0.0",
        "husky": "^9.0.0",
        "jsdom": "^26.0.0",
        "knip": "^5.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.0.0",
        "prettier-plugin-svelte": "^3.0.0",
        "sharp": "^0.34.5",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0",
        "vitest": "^2.0.0"
    },
    "lint-staged": {
        "*.{js,ts,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css}": [
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
